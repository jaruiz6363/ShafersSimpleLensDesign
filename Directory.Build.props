<Project>
  <PropertyGroup>
    <Version>0.1.0</Version>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Authors>Javier A Ruiz</Authors>
    <Company>Javier A Ruiz</Company>
    <Copyright>Copyright (c) 2026 Javier A Ruiz</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <Description>Shafer's Simple Lens Design: lens synthesis in which every surface is concentric about the chief ray or aplanatic for the marginal ray, after D. Shafer, Proc. SPIE 237 (1980); analyzed with AberrationCalculator</Description>
  </PropertyGroup>
</Project>
