<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>ShafersSimpleLensDesign</RootNamespace>
    <AssemblyName>ShafersSimpleLensDesign</AssemblyName>
    <!-- As the command line: the search builds lenses on every core, and server collection keeps them all busy. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Drawn by Assets\make-icon.ps1: the exe icon above and the window icon. -->
    <AvaloniaResource Include="Assets\icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.2.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShafersSimpleLensDesign.Core\ShafersSimpleLensDesign.Core.csproj" />
  </ItemGroup>
</Project>
